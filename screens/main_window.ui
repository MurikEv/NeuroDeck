    <widget class="QWidget" name="notepad_screen">
     <property name="styleSheet">
      <string notr="true">QWidget#notepad_screen {
    background-color: #02070b;
    color: #c3edf1;
    font-family: "Sans Serif";
    font-size: 11px;
}
QFrame#notepadHeaderGlow {
    background-color: #12090e;
    border: 1px solid #531421;
    border-radius: 5px;
}
QFrame#notepadHeader {
    background-color: #050d12;
    border: 1px solid #e63248;
    border-left: 3px solid #ff4057;
    border-radius: 3px;
}
QPushButton#notepadBackButton {
    background-color: #1b0b12;
    color: #ff4b62;
    border: 1px solid #9d2639;
    border-radius: 3px;
    font-size: 22px;
    font-weight: bold;
}
QLabel#notepadTitle {
    color: #1edff0;
    font-size: 22px;
    font-weight: bold;
    background: transparent;
}
QFrame#notepadHeaderAccent {
    background-color: #1edff0;
    border: none;
}
QPushButton[notepadNav="true"] {
    background-color: #061219;
    border: 1px solid #174650;
    border-left: 3px solid #ad293d;
    border-radius: 3px;
    color: #7ebbc4;
    font-size: 11px;
    font-weight: bold;
    text-align: left;
    padding-left: 11px;
}
QPushButton#notepadAllNotesButton {
    background-color: #08232c;
    border: 1px solid #16c7db;
    border-left: 3px solid #31efff;
    color: #50f0ff;
}
QPushButton#notepadNewNoteButton {
    background-color: #1c0c14;
    border: 1px solid #ed3b54;
    border-left: 3px solid #ff4b62;
    color: #ff6074;
    font-size: 12px;
    font-weight: bold;
}
QFrame#notepadDivider {
    background-color: #761b2d;
    border: none;
}
QFrame#notepadDividerAccent {
    background-color: #ff3d57;
    border: none;
}
QFrame#notepadContentGlow {
    background-color: #140a10;
    border: 1px solid #571725;
    border-radius: 5px;
}
QFrame#notepadContent {
    background-color: #040e14;
    border: 1px solid #b92c42;
    border-radius: 3px;
}
QLabel#notepadSectionTitle {
    background: transparent;
    color: #c4f7fb;
    font-size: 13px;
    font-weight: bold;
}
QPushButton[notepadAction="true"] {
    background-color: #061820;
    border: 1px solid #176273;
    border-radius: 3px;
    color: #20dceb;
    font-size: 10px;
    font-weight: bold;
}
QFrame#notepadToolbarRule {
    background-color: #16404b;
    border: none;
}
QFrame#notepadEmptyIcon {
    background-color: #071d26;
    border: 1px solid #1895a8;
    border-radius: 2px;
}
QFrame[notepadPaperLine="true"] {
    background-color: #1a7685;
    border: none;
}
QLabel#notepadEmptyTitle {
    background: transparent;
    color: #7ebcc6;
    font-size: 13px;
    font-weight: bold;
}
QLabel#notepadEmptyDescription {
    background: transparent;
    color: #557b86;
    font-size: 10px;
}
QWidget#notepad_screen QPushButton:pressed {
    background-color: #123640;
    border-color: #56efff;
    color: #b8faff;
}</string>
     </property>

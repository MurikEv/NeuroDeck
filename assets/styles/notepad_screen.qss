/* Additions to the existing Notepad design, scoped to this screen only. */
#notepad_screen QLineEdit, #notepad_screen QPlainTextEdit {
    background: #061820;
    color: #c4f7fb;
    border: 1px solid #176273;
    border-radius: 3px;
    padding: 4px;
    font-size: 13px;
    selection-background-color: #15536a;
}
#notepad_screen QLineEdit:focus, #notepad_screen QPlainTextEdit:focus {
    border-color: #20dceb;
}
#notepadList {
    background: #040e14;
    color: #8edce5;
    border: none;
    font-size: 11px;
    outline: none;
}
#notepadList::item {
    border-bottom: 1px solid #14313a;
    padding-left: 5px;
}
#notepadList::item:selected {
    color: #b8faff;
    background: #123640;
    border: 1px solid #e63248;
}
#notepadEditor {
    background: #040e14;
    border: 1px solid #e63248;
    border-radius: 4px;
}
#notepadEditorHeading {
    color: #20dceb;
    background: transparent;
    font-size: 17px;
    font-weight: bold;
}
#notepadEditor QPushButton, #notepadSearchClose {
    background: #061820;
    color: #20dceb;
    border: 1px solid #176273;
    border-radius: 3px;
    font-weight: bold;
    font-size: 11px;
}
#notepadEditor QPushButton:pressed, #notepadSearchClose:pressed {
    background: #123640;
    border-color: #56efff;
    color: #b8faff;
}
#notepadDeleteButton, #notepadConfirmDelete {
    color: #ff6074;
    border-color: #ad293d;
}
#notepadListStatus, #notepadEditorStatus {
    background: transparent;
    color: #7ebbc4;
    font-size: 10px;
}
#notepadDeleteOverlay {
    background: #130c14;
    border: 2px solid #e63248;
    border-radius: 4px;
}
#notepadDeleteOverlay QLabel {
    color: #c4f7fb;
    background: transparent;
    font-size: 16px;
}
#notepad_screen QScrollBar:vertical {
    background: #061820;
    width: 18px;
    margin: 0;
}
#notepad_screen QScrollBar::handle:vertical {
    background: #176273;
    min-height: 26px;
}
#notepad_screen QScrollBar::add-line:vertical,
#notepad_screen QScrollBar::sub-line:vertical {
    height: 0;
}
